---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="The requested page could not be found.">
  <section class="not-found">
    <p class="eyebrow">404</p>
    <h1>That page isn’t here.</h1>
    <p class="lede">The link may be outdated, or the page may have moved.</p>
    <a class="text-link" href="/">Return home <span aria-hidden="true">→</span></a>
  </section>
</BaseLayout>
