---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="zleinweber.com">
  <h1>Hello, world.</h1>
  <p class="lede">
    This is a small personal site for notes, essays, how-tos, and the trail of
    things I am reading and learning.
  </p>

  <section aria-labelledby="start">
    <h2 id="start">Start here</h2>
    <p>
      The site is intentionally plain for now: static pages, content files in
      the repository, and a build step that turns them into deployable HTML.
    </p>
    <p>
      Future posts can live under <a href="/writing/">writing</a> and grow into
      whatever structure becomes useful.
    </p>
  </section>
</BaseLayout>
