---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Zach Leinweber">
  <section class="hero">
    <p class="eyebrow">Hi there, my name is Zach!</p>
    <h1>I aspire to mold a calm rational mind</h1>
    <p class="lede">
      This is my tool for encouraging thought and growth in this endeavor by way
      of serving as motivation to write more. Here you'll find writing that
      externalizes what I'm working on, what I'm learning, and what I'm thinking
      about.
    </p>
    <p class="lede">
      I invite all to tag along in this journey.
    </p>
    <div class="hero-actions">
      <a class="text-link" href="/about/"
        >More about me <span aria-hidden="true">→</span></a
      >
      <a class="text-link text-link-muted" href="/blog/"
        >Read my writing <span aria-hidden="true">→</span></a
      >
    </div>
  </section>

  <section class="home-note" aria-labelledby="currently-heading">
    <p class="section-label" id="currently-heading">Currently</p>
    <p>
      This week I'm listening to 10,000 days by TOOL.
    </p>
  </section>
</BaseLayout>
