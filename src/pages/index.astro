---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Zach Leinweber">
  <section class="hero">
    <p class="eyebrow">Hello, I’m Zach.</p>
    <h1>A place for ideas, projects, and things worth sharing.</h1>
    <p class="lede">
      This is my home on the web. I write about what I’m learning, building, and thinking about.
    </p>
    <div class="hero-actions">
      <a class="text-link" href="/about/">More about me <span aria-hidden="true">→</span></a>
      <a class="text-link text-link-muted" href="/blog/">Read my writing <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="home-note" aria-labelledby="currently-heading">
    <p class="section-label" id="currently-heading">Currently</p>
    <p>
      Use this space for a short, frequently updated note about what you’re focused on now.
    </p>
  </section>
</BaseLayout>
