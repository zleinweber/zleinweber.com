---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogPost from '../components/BlogPost.astro'
const allPosts = Object.values(import.meta.glob('./posts/*.md', { eager: true }));
const pageTitle = 'Blog';
---
<BaseLayout pageTitle={pageTitle}>
  <h2>What is astro?</h2>
  <p>
  It is a web framework for building content driven websites.
  I am using to build a mostly static set of content
  </p>
  <p>
  I'm on a step of the tutorial where I'm adding an Astro "Page".
  This is more for me practicing astro than it is for me actually writing a real blog post
  </p>

  <ul>
    {allPosts.map((post: any) => <BlogPost url={post.url} title={post.frontmatter.title} />)}
  </ul>
</BaseLayout>
